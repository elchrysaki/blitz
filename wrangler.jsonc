{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blitz",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blitz-db",
      "database_id": "b9f90892-41f2-4b5e-9b55-9875eae2bd4f"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  // Once a day: forget browsers that haven't visited for 7 days, and clear old game PINs.
  "triggers": { "crons": ["17 3 * * *"] },
  // Run the Worker close to the D1 database, so the several queries behind one request don't each cross the globe.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true }
}
